{
  "name": "tarot-reflector",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "secrets:scan": "secretlint \"**/*\" --secretlintrc .secretlintrc.json",
    "ui:guard": "bash scripts/ui_guard.sh",
    "ui:audit": "bash scripts/ui_consistency_audit.sh",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run secrets:scan && npm run ui:guard",
    "cards:download": "python3 scripts/download_major_arcana.py",
    "cards:wire": "python3 scripts/wire_card_images.py",
    "audit:motifs": "tsx scripts/audit_motifs.ts",
    "audit:cards": "tsx scripts/audit_cards.ts",
    "benchmark": "tsx scripts/run_benchmark.ts",
    "benchmark:frontend": "tsx scripts/run_frontend_benchmark.ts",
    "karpathy:audit": "tsx scripts/karpathy_audit.ts",
    "test:visual": "playwright test tests/e2e/visual.spec.ts --config=playwright.visual.config.ts",
    "test:archive-regression": "playwright test tests/e2e/archive-regression.spec.ts --config=playwright.visual.config.ts",
    "test:frontend-regression": "playwright test tests/e2e/frontend-regression-guards.spec.ts",
    "test:karpathy-visual": "playwright test tests/e2e/reference-visual.spec.ts --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "test:a11y": "playwright test tests/e2e/visual.spec.ts --grep Accessibility",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:interaction": "playwright test tests/e2e/interaction.spec.ts",
    "video:preview": "tsx scripts/video_preview.ts",
    "video:render:demo": "npx remotion render remotion/Root.tsx TarotShortDemo out/demo.mp4",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{json,md,css}": []
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "dexie": "^4.4.3",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-themes": "^10.4.1",
    "@storybook/nextjs": "^10.4.1",
    "@storybook/react": "^10.4.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "20.19.42",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "enhanced-resolve": "^5.23.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "secretlint": "^13.0.2",
    "storybook": "^10.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.7"
  }
}
